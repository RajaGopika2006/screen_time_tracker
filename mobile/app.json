{
  "expo": {
    "name": "FocusGuard",
    "slug": "focusguard",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F1115"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.focusguard.app",
      "permissions": [
        "PACKAGE_USAGE_STATS",
        "SYSTEM_ALERT_WINDOW",
        "POST_NOTIFICATIONS"
      ]
    }
  }
}
